# Ethereum Sepolia RPC URL（可從 Infura、Alchemy 或直接用公用節點）
#
# ⚠️ 2026-10-13：原本這裡是 Base Sepolia（BASE_SEPOLIA_RPC_URL / sepolia.base.org），
#    現在改成 Ethereum Sepolia，與 zixi-earth 的 CHAIN_ID 11155111 對齊。
#    舊變數名 BASE_SEPOLIA_RPC_URL 已移除 —— 留著會讓人以為還在 Base Sepolia，
#    而錯誤的鏈不會報錯，只會得到一個永遠查不到交易的環境。
#    改成 chainId 11155111 是因為合約與線上服務都在 Sepolia 上。
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# 管理員錢包私鑰（請確保此錢包在 Sepolia 上有足夠的 ETH 作為 Gas 費）
# ⚠️ 警告：切勿將包含私鑰的 .env 文件上傳到 Git！
PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# SepoliaScan API KEY（選填，用於自動驗證合約源代碼）
SEPOLIASCAN_API_KEY=YOUR_SEPOLIASCAN_API_KEY